{
  "name": "lilo",
  "private": true,
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter editor dev",
    "fonts": "node --experimental-strip-types scripts/import-fonts.mjs --ensure",
    "fonts:force": "node --experimental-strip-types scripts/import-fonts.mjs",
    "fonts:check": "node --experimental-strip-types scripts/import-fonts.mjs --ensure && node --experimental-strip-types scripts/import-fonts.mjs --check-notice",
    "tauri": "cd app && tauri",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/release-scripts.test.mjs scripts/forbidden-name-guard.test.mjs scripts/compat-docs.test.mjs scripts/guide.test.mjs",
    "compat": "node scripts/build-compat-docs.mjs",
    "compat:check": "node scripts/build-compat-docs.mjs --check",
    "check-versions": "node scripts/check-versions.mjs",
    "site:dev": "pnpm --dir site install --ignore-workspace --prefer-offline && pnpm --dir site dev",
    "site:build": "pnpm --dir site install --ignore-workspace --prefer-offline && pnpm --dir site build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r typecheck",
    "guide": "node --experimental-strip-types --no-warnings scripts/gen-guide-reference.mjs && node scripts/build-guide-index.mjs",
    "guide:check": "node --experimental-strip-types --no-warnings scripts/gen-guide-reference.mjs --check && node scripts/build-guide-index.mjs --check"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
