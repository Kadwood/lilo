{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lilo",
  "version": "0.1.0",
  "identifier": "com.kadwood.lilo",
  "build": {
    "beforeDevCommand": "pnpm --filter editor dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter editor build",
    "frontendDist": "../../editor/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lilo",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-eval'",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:17841",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["lilo"],
        "name": "Lilo Project",
        "description": "Lilo embroidery project",
        "mimeType": "application/x-lilo-project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.kadwood.lilo.project",
          "conformsTo": ["public.data", "public.archive"]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "lilo"
        ]
      }
    }
  }
}
