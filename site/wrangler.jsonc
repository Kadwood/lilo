{
  // lilo.kadwood.com — static site served by Cloudflare Workers static assets.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "lilo-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  "routes": [{ "pattern": "lilo.kadwood.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
