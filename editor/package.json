  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types ../scripts/import-fonts.mjs --ensure && vite",
    "build": "node --experimental-strip-types ../scripts/import-fonts.mjs --ensure && pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types ../scripts/import-fonts.mjs --ensure && vitest run",
    "e2e": "node --experimental-strip-types ../scripts/import-fonts.mjs --ensure && vitest run -c vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@lilo/engine": "workspace:^",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "immer": "^11.1.21",
    "pixi.js": "8.22.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vtracer-wasm": "0.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
