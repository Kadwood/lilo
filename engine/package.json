{
  "name": "@lilo/engine",
  "private": true,
  "version": "1.1.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./light": "./src/light.ts",
    "./lettering": "./src/lettering/index.ts"
  },
  "scripts": {
    "test": "node --experimental-strip-types ../scripts/import-fonts.mjs --ensure && vitest run",
    "smoke": "SMOKE_OUT=${SMOKE_OUT:-.smoke} vitest run test/smoke.test.ts --silent=false && cat ${SMOKE_OUT:-.smoke}/smoke.txt",
    "typecheck": "tsc --noEmit",
    "swatches": "LILO_SWATCHES=1 vitest run test/swatches.test.ts"
  },
  "dependencies": {
    "@stitchables/stitchjs": "^1.0.37",
    "fflate": "^0.8.3",
    "image-q": "4.0.0",
    "jsts": "2.12.1",
    "opentype.js": "^2.0.0",
    "vtracer-wasm": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
